# Frontend environment for Click Photo Core Upsell
# Copy this file to .env.local and fill values before running `npm run dev` or building.

# Google Gemini API key used by AI Studio (if applicable)
VITE_GEMINI_API_KEY=

# Stripe publishable key for collecting payments
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_TYooMQauvdEDq54NiTphI7jx

# Supabase project credentials
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: override table names if your schema differs
VITE_SUPABASE_ACCESS_TABLE=access_records
VITE_SUPABASE_ANALYTICS_TABLE=analytics_events
VITE_SUPABASE_PURCHASES_TABLE=purchases
VITE_SUPABASE_ABANDONMENTS_TABLE=abandoned_checkouts

# Email automation endpoint (e.g., Supabase Edge Function or other service)
VITE_EMAIL_FUNCTION_URL=
